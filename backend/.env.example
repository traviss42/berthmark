# Environment Configuration for Berthmark Backend
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Security / Authentication
SECRET_KEY=development-secret-key-replace-in-production-min-32-chars
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# External APIs
# Open-Meteo Marine Weather API (No key required for non-commercial tier)
OPENMETEO_BASE_URL=https://marine-api.open-meteo.com/v1/marine

# AISStream / Vessel Tracking API (Optional: app falls back to realistic simulation if empty)
AISSTREAM_API_KEY=
AISSTREAM_BASE_URL=https://api.aisstream.io/v1

# UN/LOCODE / Port Reference API
PORTS_API_BASE_URL=https://raw.githubusercontent.com/datasets/un-locode/master

# HTTP Client Settings
HTTP_TIMEOUT_SECONDS=5.0
