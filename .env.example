# Berthmark Platform Environment Configuration

# Database Configuration (PostgreSQL / PostGIS or SQLite)
DATABASE_URL=sqlite+aiosqlite:////app/berthmark.db
# For PostgreSQL container: postgresql+asyncpg://postgres:postgres@db:5432/maritime_risk

# Redis Cache Configuration
CACHE_URL=redis://redis:6379

# AISStream Real-time WebSocket Feed (BYOK - Bring Your Own Key)
# Obtain an API key from https://aisstream.io
AISSTREAM_API_KEY=your_aisstream_api_key_here

# Security & Authentication
JWT_SECRET_KEY=berthmark-development-insecure-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Ports & Node Environment
PORT=8000
NODE_ENV=production
